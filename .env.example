# 应用时区（用于页面显示）
APP_TIMEZONE=Asia/Tashkent

# XDB 版本信息来源
XDB_META_URL=https://ip2region.net/api/public/data/offline/ver_latest?t=646a0d6627.3e0.69944e81.OS002@GJB

# XDB 版本缓存文件（建议放到 data 目录）
XDB_META_CACHE_FILE=/Users/gentpan/projects/ip.bluecdn.com/data/xdb_meta_cache.json

# 拉取远程版本信息的超时时间（秒）
XDB_META_HTTP_TIMEOUT=6

# 每月更新计划（用于判断何时刷新显示）
# 每个月 2 号 00:00 执行刷新判断
XDB_META_UPDATE_DAY=2
XDB_META_UPDATE_HOUR=0
XDB_META_UPDATE_MINUTE=0
XDB_META_TIMEZONE=Asia/Tashkent

# 自动更新脚本状态/锁文件
XDB_UPDATE_STATE_FILE=/Users/gentpan/projects/ip.bluecdn.com/data/xdb_update_state.json
XDB_UPDATE_LOCK_FILE=/Users/gentpan/projects/ip.bluecdn.com/data/xdb_update.lock

# 每日最大下载次数（上限 12）
XDB_AUTO_MAX_DAILY_DOWNLOADS=12

# 下载超时（秒）
XDB_DOWNLOAD_TIMEOUT_SECONDS=1800

# v4 / v6 付费版下载地址
XDB_V4_DOWNLOAD_URL=https://ip2region.net/api/public/data/offline/get_file?t=6cb96dca7d.3e0.69944e4b.OF002@GJB&v=v001@full
XDB_V6_DOWNLOAD_URL=https://ip2region.net/api/public/data/offline/get_file?t=646a0d6627.3e0.69944e81.OS002@GJB&v=v001@full

# 下载完成后替换到线上正在使用的文件名
XDB_V4_LOCAL_FILE=/Users/gentpan/projects/ip.bluecdn.com/data/high_full.xdb
XDB_V6_LOCAL_FILE=/Users/gentpan/projects/ip.bluecdn.com/data/high_full_v6.xdb
