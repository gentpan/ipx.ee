[Unit]
Description=ipx.ee Go service
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/ipx.ee/go-backend
Environment=PORT=18080
Environment=PROJECT_ROOT=/opt/ipx.ee
EnvironmentFile=-/opt/ipx.ee/go-backend/.env
ExecStart=/opt/ipx.ee/go-backend/backend
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
